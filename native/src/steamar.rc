// Icon and version block for SteaMar.exe. The icon is generated from logo.png by
// tools/make-icon.ps1 - replace the artwork, rerun that, rebuild; nothing here changes.

#include <windows.h>

#define APP_VERSION 4, 0, 2, 0
#define APP_VERSION_TEXT "4.0.2.0"

1 ICON "..\\assets\\steamar.ico"

VS_VERSION_INFO VERSIONINFO
  FILEVERSION APP_VERSION
  PRODUCTVERSION APP_VERSION
  FILEFLAGSMASK 0x3fL
  FILEFLAGS 0x0L
  FILEOS VOS_NT_WINDOWS32
  FILETYPE VFT_APP
  FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "SteaMar"
      VALUE "FileDescription", "SteaMar - shared game library"
      VALUE "FileVersion", APP_VERSION_TEXT
      VALUE "InternalName", "SteaMar"
      VALUE "OriginalFilename", "SteaMar.exe"
      VALUE "ProductName", "SteaMar"
      VALUE "ProductVersion", APP_VERSION_TEXT
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
