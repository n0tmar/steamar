{
  "name": "steamar",
  "version": "4.0.2",
  "private": true,
  "license": "MIT",
  "description": "SteaMar - a shared Steam game library for Windows 11: store browsing, one-click add and install, Lua entitlements.",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "doctor": "node src/doctor.js",
    "gen": "node src/gen.js",
    "drop": "node src/drop.js",
    "drift": "node src/drift.js",
    "app": "native\\build\\Release\\SteaMar.exe",
    "build:app": "cmake -S native -B native/build -G \"Visual Studio 17 2022\" -A x64 && cmake --build native/build --config Release",
    "test": "node --test \"test/*.test.js\"",
    "test:e2e": "node test/e2e/routes.js && node test/e2e/edges.js",
    "test:app": "node test/e2e/bridge.js",
    "version": "node tools/version.js",
    "version:write": "node tools/version.js --write",
    "ui:check": "node tools/ui-sync.js",
    "ui:sync": "node tools/ui-sync.js --write",
    "check:ui": "node tools/check-ui.js",
    "check:views": "node tools/check-views.js"
  }
}
